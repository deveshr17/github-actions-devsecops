# Local development settings for app/ (copy to .env; .env is git-ignored).
# The container image reads the same variables via the ConfigMap in k8s/base.

PORT=8080
HOST=0.0.0.0
SERVICE_NAME=sample-service
SERVICE_VERSION=0.0.0-local
GIT_SHA=local
DRAIN_DELAY_MS=1000
SHUTDOWN_TIMEOUT_MS=10000
LOG_LEVEL=debug

# --- Values used by the Makefile for local image builds / scans (placeholders) ---
ARTIFACT_REGISTRY_HOST=asia-south1-docker.pkg.dev
GCP_PROJECT_ID=example-project-dev
ARTIFACT_REGISTRY_REPO=apps
IMAGE_NAME=sample-service
